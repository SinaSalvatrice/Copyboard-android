{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copyboard",
  "version": "0.1.0",
  "identifier": "de.circuitcurios.copyboard.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Copyboard",
        "width": 1400,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true
      },
      {
        "label": "floating",
        "title": "Copyboard Floating",
        "width": 120,
        "height": 36,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}