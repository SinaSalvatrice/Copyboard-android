<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetNotesTitle"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="Notiz"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetNotesChange"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/snippet_button_background"
            android:gravity="center"
            android:minWidth="68dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Wählen"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetNotesOpenApp"
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetNoteBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/snippet_button_background"
        android:ellipsize="end"
        android:gravity="top|start"
        android:maxLines="12"
        android:padding="12dp"
        android:text="Wähle eine Notiz für dieses Widget."
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widgetNoteCopy"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/snippet_button_background"
        android:gravity="center"
        android:text="Notiz kopieren"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
